# --- Google OAuth (NextAuth / Auth.js) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

AUTH_URL=http://localhost:8090
AUTH_TRUST_HOST=true

PORT=8090

# --- Supabase (profiles, match history, KHQR storage) ---
# Project URL + service role key from https://supabase.com/dashboard →
# Project Settings → API. The service role key bypasses row-level security,
# so it is read on the server only — never ship it to the browser.
# Leave these blank to run the game fully in memory (no persistence).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public storage bucket that holds the uploaded KHQR images.
SUPABASE_QR_BUCKET=khqr

# --- Operators ---
# Comma-separated Google account emails allowed to open /admin: set the
# payment KHQR and approve players' point purchases. Leave blank to disable
# the operator console entirely.
ADMIN_EMAILS=you@example.com

# --- Hosting ---
# Set to `polling` on hosts that refuse incoming WebSocket connections
# (Hostinger Web/Cloud plans). Leave unset on a VPS or locally so Socket.IO
# upgrades to a real WebSocket. See DEPLOY.md.
# NEXT_PUBLIC_SOCKET_TRANSPORT=polling
